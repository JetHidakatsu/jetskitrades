# Solana RPC Configuration
QUICKNODE_RPC_URL=your_quicknode_rpc_url_here
QUICKNODE_WS_URL=your_quicknode_websocket_url_here
PRIVATE_KEY=your_solana_wallet_private_key_here
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_ENDPOINT=https://api.helius.xyz/v0

# Trading Configuration
INITIAL_CAPITAL=0.1
RISK_PERCENTAGE=0.02
MAX_POSITION_SIZE=0.1
MIN_POSITION_SIZE=0.01
RISK_FACTOR=0.5
MAX_SLIPPAGE=0.02
MIN_LIQUIDITY=1000
SENTIMENT_THRESHOLD=0.6

# Performance Settings
MAX_POSITIONS=5
WEBSOCKET_PING_INTERVAL=30

# Quantum Settings
QUANTUM_WEIGHT=0.4
SENTIMENT_WEIGHT=0.3
TECHNICAL_WEIGHT=0.3
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here
IBM_QUANTUM_BACKEND=ibmq_qasm_simulator

# Monitoring Configuration
METRICS_PORT=8000
LOG_LEVEL=DEBUG
