# Network Configuration
NETWORK=mainnet-beta
RPC_URL=https://your-rpc-url.com
WS_URL=wss://your-ws-url.com
HELIUS_API_KEY=your_helius_api_key_here
DEXSCREENER_API_KEY=your_dexscreener_api_key_here

# Wallet Configuration
WALLET_PRIVATE_KEY=your_wallet_private_key_here
WALLET_PUBLIC_KEY=your_wallet_public_key_here

# Trading Parameters
INITIAL_CAPITAL=0.12
MAX_POSITION_SIZE=0.05
STOP_LOSS_PCT=0.20
TAKE_PROFIT_PCT=0.50
MOONBAG_PCT=0.10
MIN_LIQUIDITY=0.1
MIN_HOLDER_COUNT=10

# Quantum Configuration
QUANTUM_SCORE_THRESHOLD=0.7
QUANTUM_UPDATE_INTERVAL=30
QUANTUM_MAX_POOLS=10
QUANTUM_MIN_SCORE=0.6
QUANTUM_WEIGHT=0.3
QUANTUM_DEPTH_FACTOR=0.5
QUANTUM_VOLATILITY_FACTOR=0.4
QUANTUM_MOMENTUM_FACTOR=0.3

# Pool Validation
MIN_POOL_AGE_HOURS=1
MIN_POOL_LIQUIDITY_SOL=1.0
MAX_OWNER_PERCENTAGE=20.0
MIN_UNIQUE_HOLDERS=50
MAX_SINGLE_HOLDER_PCT=5.0

# Transaction Parameters
MAX_PRIORITY_FEE=0.000001
MAX_COMPUTE_UNITS=200000
PARALLEL_TXS=3
RETRY_COUNT=3
CONFIRMATION_TIMEOUT=30

# Dynamic Sizing Parameters
USE_DYNAMIC_SIZING=true
MIN_POSITION_SIZE=0.01
MAX_TOTAL_EXPOSURE=0.3
RISK_FACTOR=0.4
MAX_EXPOSURE_PER_TOKEN=0.1

# Monitoring
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_SECRET=your_twitter_access_secret_here

# Performance Monitoring
PROMETHEUS_PORT=9090
GRAFANA_API_KEY=your_grafana_api_key_here
PERFORMANCE_LOG_INTERVAL=300
METRICS_UPDATE_INTERVAL=60

# Database
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://user:pass@localhost:5432/dbname

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot.log

# Development
DEBUG=false
TEST_MODE=false
MOCK_TRADES=false

# API Keys for Analysis
ETHERSCAN_API_KEY=your_etherscan_api_key_here
BSCSCAN_API_KEY=your_bscscan_api_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
COINGECKO_API_KEY=your_coingecko_api_key_here

# Risk Management
MAX_RISK_PER_TRADE=0.02
MAX_DAILY_RISK=0.10
MAX_DRAWDOWN=0.30
MAX_RUG_RISK=0.3
MAX_HONEYPOT_RISK=0.3
MIN_LIQUIDITY_RATIO=0.1
MAX_CONCENTRATION_PCT=20.0
MIN_HOLDER_DISTRIBUTION=0.4
MAX_MINT_AUTHORITY_RISK=0.5
MAX_FREEZE_AUTHORITY_RISK=0.5

# Backtesting
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-01-31
BACKTEST_INITIAL_CAPITAL=1.0
BACKTEST_TRADING_FEES=0.003

# Mempool Monitoring
MEMPOOL_SCAN_INTERVAL=1
MEMPOOL_MAX_AGE_SECONDS=60
MEMPOOL_MIN_TRANSACTIONS=10
MEMPOOL_BATCH_SIZE=100

# Pool Analysis
MIN_LIQUIDITY_RATIO=0.5
MAX_PRICE_IMPACT=0.05
MIN_VOLUME_24H=1000
MAX_SLIPPAGE=0.03

# Token Analysis
MIN_MARKET_CAP=10000
MAX_SUPPLY_CONCENTRATION=0.20
MIN_DAILY_TRANSACTIONS=100
MIN_ACTIVE_WALLETS=50

# Technical Analysis
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Sentiment Analysis
SENTIMENT_UPDATE_INTERVAL=300
MIN_SENTIMENT_SCORE=0.6
MIN_SOCIAL_VOLUME=1000
SOCIAL_METRICS_WEIGHT=0.4
TECHNICAL_METRICS_WEIGHT=0.6

# Position Management
MAX_OPEN_POSITIONS=5
POSITION_SIZING_METHOD=kelly
PORTFOLIO_REBALANCE_THRESHOLD=0.1

# Network Management
RPC_TIMEOUT=10
WS_RECONNECT_DELAY=5
MAX_RPC_RETRIES=3
RATE_LIMIT_PER_SECOND=10

# Memory Management
MAX_MEMORY_USAGE_MB=2048
GARBAGE_COLLECTION_INTERVAL=300
CACHE_TTL_SECONDS=3600

# Security
IP_WHITELIST=127.0.0.1,192.168.1.1
MAX_LOGIN_ATTEMPTS=3
SESSION_TIMEOUT=3600
API_RATE_LIMIT=100

# Advanced Features
USE_PARALLEL_EXECUTION=true
USE_PRIORITY_FEES=true
USE_MOONBAG_STRATEGY=true
USE_DYNAMIC_SIZING=true
ENABLE_EMERGENCY_SHUTDOWN=true
